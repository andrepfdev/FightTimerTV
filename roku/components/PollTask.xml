<?xml version="1.0" encoding="utf-8" ?>
<!--
  Task SceneGraph: toda chamada de rede em SceneGraph precisa rodar fora
  da thread de render, e Task é o mecanismo padrão pra isso — roda numa
  thread própria. `control` (RUN/STOP) já vem de graça do Task base;
  só declaramos os campos específicos deste poller.
-->
<component name="PollTask" extends="Task">
    <interface>
        <!-- URL completa de /state (ex.: http://192.168.0.42:8080/state),
             montada pelo MainScene a partir do IP configurado. -->
        <field id="uri" type="string" value="" />
        <!-- JSON cru da última resposta, ou "__FAIL__" quando a
             requisição falha/expira. alwaysNotify pra garantir que o
             MainScene seja avisado mesmo se dois polls seguidos vierem
             com o mesmo corpo (ex.: segundo parado). -->
        <field id="response" type="string" value="" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/PollTask.brs" />
</component>
