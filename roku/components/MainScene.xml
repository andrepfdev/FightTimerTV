<?xml version="1.0" encoding="utf-8" ?>
<!--
  Cena principal do canal. Espelha o layout/cores de
  src/receiver/receiverHtml.ts (fundo escuro, número gigante amarelo,
  indicador de round, barra de progresso, overlay "FIM", banner de
  offline) — só que desenhado em SceneGraph em vez de HTML/CSS, e
  alimentado por PollTask em vez de fetch()/setTimeout.

  A tela de digitar IP:porta é um teclado numérico simples, todo
  controlado por esta própria cena (sem componente filho separado) —
  em teste real numa Roku de verdade, roteamento de tecla pra dentro de
  um componente customizado aninhado (IpEntry) se mostrou não-confiável
  mesmo com foco nativo confirmado via hasFocus(); a MainScene em si
  sempre recebe as teclas corretamente, então o teclado é gerenciado
  aqui com destaque manual (cor), sem depender de setFocus() por tecla.
-->
<component name="MainScene" extends="Scene">
    <interface>
    </interface>

    <children>
        <Rectangle id="background" color="0x1A1A1AFF" width="1920" height="1080" />

        <Label id="logo" text="FIGHT TIMER" translation="[40, 36]"
               color="0xFFFFFF66" />

        <Label id="offlineBanner"
               text="Sem conexão com o celular — tentando reconectar…"
               translation="[0, 70]" width="1920" horizAlign="center"
               color="0xFF4444FF" visible="false" />

        <Label id="roundIndicator" text="Aguardando o celular…"
               translation="[0, 360]" width="1920" horizAlign="center"
               color="0xFFFFFFE0" />

        <Label id="bigTimer" text="00:00"
               translation="[0, 420]" width="1920" height="440"
               horizAlign="center" vertAlign="center"
               color="0x666666FF" />

        <Rectangle id="progressWrap" translation="[0, 1060]"
                   width="1920" height="20" color="0xFFFFFF0D" />
        <Rectangle id="progressFill" translation="[0, 1060]"
                   width="0" height="20" color="0xC8F400FF" />

        <Group id="doneOverlay" visible="false">
            <Rectangle id="doneBg" color="0x1A1A1AF7" width="1920" height="1080" />
            <Label id="doneTitle" text="FIM!" translation="[0, 400]"
                   width="1920" horizAlign="center" color="0xC8F400FF" />
            <Label id="doneSub" text="" translation="[0, 640]"
                   width="1920" horizAlign="center" color="0x666666FF" />
        </Group>

        <!-- Configuração de endereço: 4 "spinners" numéricos (0-255),
             sem teclado nenhum — cima/baixo sobe/desce o valor do campo
             atual, esquerda/direita troca de campo, OK confirma. Porta
             sempre 8080 (fixa, igual ao SERVER_PORT do app RN), nunca
             editável. Primeiros 3 números já vêm com "192.168.0" —
             palpite de rede doméstica típica (bateu com Roku e celular
             nos testes) — só o último costuma precisar mudar. -->
        <Group id="ipEntryGroup" visible="false">
            <Rectangle id="ipEntryBg" color="0x1A1A1AFF" width="1920" height="1080" />
            <Label id="ipEntryTitle" text="Digite o endereço mostrado no celular"
                   translation="[0, 120]" width="1920" horizAlign="center"
                   color="0xFFFFFFFF" />
            <Label id="ipEntryHint"
                   text="Esquerda/Direita trocam de campo — Cima/Baixo mudam o número — OK confirma tudo"
                   translation="[0, 190]" width="1920" horizAlign="center"
                   color="0x666666FF" />

            <Rectangle id="ipDisplayBg" translation="[560, 350]" width="800" height="140"
                       color="0x2A2A2AFF" />
            <Label id="octet0" text="192" translation="[590, 350]" width="130" height="140"
                   horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
            <Label id="dot0" text="." translation="[720, 350]" width="30" height="140"
                   horizAlign="center" vertAlign="center" color="0x666666FF" />
            <Label id="octet1" text="168" translation="[750, 350]" width="130" height="140"
                   horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
            <Label id="dot1" text="." translation="[880, 350]" width="30" height="140"
                   horizAlign="center" vertAlign="center" color="0x666666FF" />
            <Label id="octet2" text="0" translation="[910, 350]" width="130" height="140"
                   horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
            <Label id="dot2" text="." translation="[1040, 350]" width="30" height="140"
                   horizAlign="center" vertAlign="center" color="0x666666FF" />
            <Label id="octet3" text="1" translation="[1070, 350]" width="130" height="140"
                   horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
            <Label id="colonPort" text=":8080" translation="[1200, 350]" width="150" height="140"
                   vertAlign="center" color="0x666666FF" />

            <Label id="confirmHint" text="Aperte OK pra confirmar este endereço"
                   translation="[0, 540]" width="1920" horizAlign="center"
                   color="0xC8F400FF" />
        </Group>

        <PollTask id="pollTask" />
        <Audio id="bellAudio" />

        <!-- setFocus() chamado durante a construção da cena (antes de
             roSGScreen.show() rodar em main.brs) falha silenciosamente —
             confirmado em teste real. Esse Timer adia a primeira (e
             única) tentativa de foco da cena pra depois dela já estar
             de fato na tela. -->
        <Timer id="initialFocusTimer" duration="0.3" repeat="false" />
    </children>

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
