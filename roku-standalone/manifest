title=CT Timer Standalone
major_version=1
minor_version=0
build_version=7

; Usa coordenadas 1920x1080 — mesmo layout base do canal com celular
; (roku/), só que sem servidor externo nenhum: o cronograma de rounds é
; montado localmente a partir da configuração feita pelo controle remoto.
ui_resolutions=fhd

mm_icon_focus_hd=pkg:/images/icon_focus_hd.png
splash_screen_fhd=pkg:/images/splash_fhd.png

; Fundo escuro atrás do splash enquanto carrega, igual ao --dark do
; receptor HTML (#1a1a1a).
splash_color=#1a1a1a
splash_min_time=800
